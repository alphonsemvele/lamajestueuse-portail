# Fichier .env du SERVEUR (lamajestueuse.com).
# À copier en .env à la racine de l'application, puis à compléter.
# Il n'est jamais envoyé par le pipeline : il reste sur le serveur.

APP_NAME="La Majestueuse"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lamajestueuse.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Journaux : un fichier par jour, seulement les erreurs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Le site est en HTTPS : le cookie de session ne doit pas circuler en clair.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Courriel (validation des comptes, mots de passe oubliés).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="portail@lamajestueuse.com"
MAIL_FROM_NAME="${APP_NAME}"

# Les identifiants des applications raccordées (IUM, IFPM, GSBM) ne sont pas ici :
# ils sont enregistrés, chiffrés, dans la table applications du portail.
